# Optional PayPal sandbox credentials.
# If either value is empty, the adapter runs in labeled SANDBOX SIMULATION mode
# with the identical create-order + capture flow shape.
#
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
# then paste the sandbox Client ID and Secret here. Never commit real secrets.

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PORT=3000
